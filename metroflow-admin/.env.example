# Copy to metroflow-admin/.env.local. Never commit the local file.
# NEXT_PUBLIC_* values are embedded in the browser bundle and are public by
# design. Protect them with key scopes and origin restrictions, not secrecy.
# The service-role key must never appear in this file.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional. When absent, the map falls back to OpenStreetMap raster tiles.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your-mapbox-public-token
