# Copy to metroflow-admin/.env.local. Never commit the local file.
# NEXT_PUBLIC_* values are embedded in the browser bundle and are public by
# design. Protect them with key scopes and origin restrictions, not secrecy.
# This app reads no Supabase key: it signs in through the FastAPI backend and
# never opens a Supabase connection from the browser. The service-role key must
# never appear in this file.

# Base URL of the MetroFlow API. When absent the client falls back to
# http://localhost:8000, so set it in any environment that is not a local dev box.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional. When absent, the map falls back to OpenStreetMap raster tiles.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your-mapbox-public-token
