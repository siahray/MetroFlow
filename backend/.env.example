# Copy to backend/.env and adjust for your machine. Never commit backend/.env.
# docker-compose.yml already provisions the local database and Redis below.

# --- Runtime ---------------------------------------------------------------
# development | test | production
# development seeds the demo road network and serves /docs. production skips the
# seed and serves no /docs or /redoc; /openapi.json stays available.
FASTAPI_ENV=development

DATABASE_URL=postgresql+psycopg2://metroflow_admin:metroflow_password@localhost:5432/metroflow_db
# Hosted runtime: use the session pooler with sslmode=require and a dedicated
# application role (not the postgres superuser), for example:
# postgresql+psycopg2://metroflow_app:password@pooler-host:5432/postgres?sslmode=require
REDIS_URL=redis://localhost:6379/0

# --- Session tokens --------------------------------------------------------
# Signs the HS256 tokens issued by /api/v1/auth/login. The built-in fallback is
# public, so set this to a long random value anywhere that is not a local dev
# box, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
JWT_SECRET=change-me-in-any-real-deployment

# --- Supabase --------------------------------------------------------------
# The API reaches Supabase only through DATABASE_URL; it loads no Supabase
# client and reads no anon key. The service-role key is reserved for evidence
# storage, which is not implemented yet. Never expose it to a client.
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- External data ---------------------------------------------------------
# Runtime rainfall (optional; manual rainfall remains the fallback).
OPENWEATHER_API_KEY=your-openweather-api-key
# Offline preprocessing only; never shipped to a browser.
OPENTOPOGRAPHY_API_KEY=your-opentopography-api-key
COPERNICUS_CLIENT_ID=your-copernicus-client-id
COPERNICUS_CLIENT_SECRET=your-copernicus-client-secret

# --- Generated deployment credential --------------------------------------
# Shared credential for the sensor gateway. Generate a random value per
# deployment; this is not a third-party API key.
METROFLOW_SENSOR_TOKEN=change-me-at-deployment

# --- Bootstrap dispatcher --------------------------------------------------
# Used once, when the user table is empty, to create the first LGU dispatcher.
# Registration never grants an administrative role. Change the password before
# exposing the API to anything beyond localhost.
# METROFLOW_ADMIN_EMAIL=dispatcher@metroflow.local
# METROFLOW_ADMIN_PASSWORD=metroflow-dev

# --- Calibration overrides -------------------------------------------------
# Every calibration or threshold setting is overridable with METROFLOW_*.
# METROFLOW_PONDING_AMPLIFICATION=3.5
# METROFLOW_CAUTION_DEPTH_CM=10
# METROFLOW_DEFAULT_CLEARANCE_CM=30
# METROFLOW_CURVE_NUMBER=85
# METROFLOW_RAINFALL_DURATION_HRS=1
# Comma-separated browser origins allowed to call the API. Defaults to `*`
# (any origin, credentials not advertised); set an explicit list before
# exposing the API.
# METROFLOW_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# METROFLOW_MAX_UPLOAD_MB=8
# METROFLOW_DRIVER_RETENTION_HOURS=24
# METROFLOW_SENSOR_DEBOUNCE_MINUTES=10
# Raise these for a long-running local `uvicorn --reload` dev server: the
# defaults (2+3) are sized for serverless and get exhausted by a couple of
# open browser tabs each holding 2-3 SSE streams (hazards/fleet/SOS) for up
# to event_stream_lifetime_seconds. Production keeps the small defaults.
# METROFLOW_DB_POOL_SIZE=10
# METROFLOW_DB_MAX_OVERFLOW=10
