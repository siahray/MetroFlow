{
  "expo": {
    "name": "MetroFlow",
    "slug": "metroflow-mobile",
    "scheme": "metroflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MetroFlow uses your location to plan flood-safe routes and warn you about nearby hazards."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MetroFlow attaches a photo you choose to a flood report so the moderation desk can verify the water level.",
          "cameraPermission": "MetroFlow uses the camera to photograph flood water levels for field reports.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite"
    ]
  }
}
