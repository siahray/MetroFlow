# Copy to metroflow-mobile/.env. Never commit the real file.
# EXPO_PUBLIC_* values are embedded in the app bundle, so they are public by
# design. This app holds no Supabase credential: it signs in through the
# FastAPI backend, which owns the database connection.

# Base URL of the MetroFlow API. Defaults to http://localhost:8000 when unset.
# On a physical device, point this at the host machine's LAN address, not
# localhost.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Reserved. The map uses the platform provider (react-native-maps); set this
# only when the raster tile layer lands.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Optional: Mapbox public token (pk.…) for the driver basemap. Leave empty to use the
# keyless Carto tiles. Restrict scopes to styles:tiles and set a usage alert.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
