# ---------------------------------------------------------------------------
# MetroFlow monorepo
# ---------------------------------------------------------------------------
# metroflow-admin/ carries its own Next.js .gitignore. This file covers the Python
# backend, the toolchain, and OS/editor noise at the repository root.

# --- Python / backend -------------------------------------------------------
backend/venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node / root tooling ----------------------------------------------------
# The root package.json only carries husky. metroflow-admin/ has its own .gitignore.
node_modules/

# --- Environment / secrets --------------------------------------------------
.env
.env.*
!.env.example

# --- OS / editor ------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Documentation build tooling --------------------------------------------
.docx-venv/
~$*.docx
